# ==============================================================================
# Web Application Firewall (WAF) & MedCore Health Environment Configuration
# ==============================================================================
# Copy this file to .env and customize values for your deployment.

# ------------------------------------------------------------------------------
# 1. Target Upstream Backend Server (FastAPI / OWASP Juice Shop)
# ------------------------------------------------------------------------------
# For OWASP Juice Shop: http://localhost:3000
# For MedCore FastAPI backend: http://127.0.0.1:8080
WAF_BACKEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database Configuration (Optional - for MedCore Backend)
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_password_here
MYSQL_DATABASE=medcore_db

# ------------------------------------------------------------------------------
# 3. Next.js Frontend Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WAF_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 4. WAF Server Binding & Network Settings
# ------------------------------------------------------------------------------
WAF_HOST=0.0.0.0
WAF_PORT=8000
WAF_WORKERS=1
WAF_FORWARD_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 5. Security Audit Logs & Storage
# ------------------------------------------------------------------------------
WAF_LOG_DIR=logs
WAF_LOG_FILE=logs/waf.log
WAF_LOG_LEVEL=INFO
WAF_ENABLE_CONSOLE_LOGS=true

# ------------------------------------------------------------------------------
# 6. Rate Limiting (Token Bucket & Sliding Window)
# ------------------------------------------------------------------------------
WAF_RATE_LIMIT_ENABLED=true
WAF_RATE_LIMIT_ALGORITHM=token_bucket
WAF_RATE_LIMIT_REQUESTS_PER_MINUTE=60
WAF_RATE_LIMIT_REQUESTS_PER_HOUR=1000
WAF_RATE_LIMIT_REQUESTS_PER_DAY=10000
WAF_RATE_LIMIT_BURST=20

# ------------------------------------------------------------------------------
# 7. Header Validation & RFC Compliance
# ------------------------------------------------------------------------------
WAF_HEADER_VALIDATION_ENABLED=true
WAF_REQUIRED_HEADERS=["host", "user-agent"]
WAF_BLOCKED_USER_AGENTS=["sqlmap", "nikto", "nmap", "masscan", "w3af", "zgrab", "gobuster", "dirbuster", "acunetix", "havij"]
WAF_ALLOWED_HOSTS=[]
WAF_MAX_HEADER_SIZE=16384
WAF_STRICT_CONTENT_LENGTH=false

# ------------------------------------------------------------------------------
# 8. Inspectors & Normalization Engine
# ------------------------------------------------------------------------------
WAF_URL_INSPECTION_ENABLED=true
WAF_BODY_INSPECTION_ENABLED=true
WAF_MAX_URL_LENGTH=4096
WAF_MAX_BODY_SIZE=10485760
WAF_MAX_DECODE_ITERATIONS=3
